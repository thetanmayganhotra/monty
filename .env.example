# Get a key at https://console.groq.com -> API Keys
GROQ_API_KEY=

# Optional override; defaults to the fast model (openai/gpt-oss-20b)
# defined in src/llm/providers/groqProvider.ts
GROQ_MODEL=

# Optional, unused unless you switch back — create a project at
# https://supabase.com (Project Settings -> API). The app currently uses
# Firebase below instead.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Create a project at https://console.firebase.google.com, add a Web app
# to it, and copy these from Project Settings -> General -> Your apps.
# Also enable Authentication -> Sign-in method -> Phone, and Firestore
# Database (start in production mode; rules are in firebase/firestore.rules).
# Until these are set, the app runs fully local (AsyncStorage) — see
# src/backend/firebaseClient.ts.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
